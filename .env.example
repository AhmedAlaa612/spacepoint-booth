# Kiosk API Endpoints
# Local or production kiosk camera backend (for hardware triggering via MQTT)
VITE_API_URL=https://selfie.spacepoint.ae

# SpacePoint Portal API (for R2 photo uploads, LMS account auto-provisioning & email delivery)
VITE_PORTAL_API_URL=https://portal.spacepoint.ae/api

# Default event slug (can also be passed dynamically in the URL: ?event=your-event-slug)
VITE_DEFAULT_EVENT_SLUG=sef-2026
