# Backend Environment Variables
# Copy this file to .env and fill in your real values — do NOT commit .env

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/spacepoint

# MQTT broker host (no mqtt:// prefix)
# Use an online broker like broker.emqx.io
MQTT_BROKER_URL=broker.emqx.io

# Gmail SMTP credentials (use a Gmail App Password, not your main password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
